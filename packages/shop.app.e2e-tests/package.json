{
  "name": "shop.app.e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for Shop.App",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "test:admin": "wdio run wdio.conf.ts --spec ./tests/admin/**/*.spec.ts",
    "test:admin:auth": "wdio run wdio.conf.ts --spec ./tests/admin/auth/**/*.spec.ts",
    "test:admin:products": "wdio run wdio.conf.ts --spec ./tests/admin/products/**/*.spec.ts"
  },
  "keywords": ["e2e", "testing", "webdriverio"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.30",
    "@wdio/cli": "^8.16.22",
    "@wdio/globals": "^8.16.22",
    "@wdio/local-runner": "^8.16.22",
    "@wdio/mocha-framework": "^8.16.22",
    "@wdio/spec-reporter": "^8.16.22",
    "wdio-chromedriver-service": "^8.1.1",
    "chromedriver": "^135.0.0",
    "@wdio/types": "^8.16.22",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "webdriverio": "^8.16.22"
  }
}
